{
  "name": "saigai-timeline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=1 next dev",
    "dev:local": "NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080/api next dev",
    "build": "next build && rm -f out/mockServiceWorker.js",
    "build:mock": "NEXT_PUBLIC_API_MOCK=1 next build",
    "serve": "node scripts/serve-out.mjs 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-security": "4.2.0",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
