# terraform.tfvars にコピーして値を入れる（.gitignore 済み。公開リポジトリに載せない）
account_id  = "123456789012"
root_domain = "example.com"
alarm_email = "alerts@example.com"

# SES: ドメインの認証を作って本番利用を申請し、承認されたら production
# ses_mode = "off" # off → identity（本番利用を申請）→ production（承認後）

# 最初のデプロイが終わったら true（取り込みの定期実行を動かす）
# ingest_enabled = false
