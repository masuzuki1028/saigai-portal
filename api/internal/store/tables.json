    { "name": "timeline", "attributes": [["PK", "S"], ["SK", "S"]], "keySchema": ["PK", "SK"], "ttl": "ttl" },
    { "name": "audit", "attributes": [["PK", "S"], ["SK", "S"]], "keySchema": ["PK", "SK"], "ttl": "ttl" }
  ]
